    <string name="stage_1_fact">基础注意力保持完好，进入深度专注更轻松。</string>
    <string name="stage_2_fact">频繁切换应用会割裂工作记忆，让冲动出现得更频繁。</string>
    <string name="stage_3_fact">随机奖励式的信息流会放大渴望，同时削弱慢节奏任务带来的满足感。</string>
    <string name="stage_4_fact">快节奏信息流会让专注力跌到基线以下，阅读、学习或深度工作都变得索然无味。</string>
    <string name="stage_5_fact">拇指进入自动驾驶，注意力被接管。实实在在的阻力能打断这种反射。</string>
    <string name="stage_1_haptic">轻柔的单次轻触</string>
    <string name="stage_2_haptic">柔和的两次轻触</string>
    <string name="stage_3_haptic">沉重的阻力脉冲</string>
    <string name="stage_4_haptic">断续不均的脉冲</string>
    <string name="stage_5_haptic">深沉厚重的脉冲</string>

